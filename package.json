{
  "name": "knowl-pad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "typecheck": "vue-tsc --noEmit && vue-tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node scripts/run-with-retry.mjs node ./node_modules/vitest/vitest.mjs run",
    "test:coverage": "node scripts/run-with-retry.mjs node ./node_modules/vitest/vitest.mjs run --coverage",
    "test:security": "node scripts/run-security.mjs",
    "test:reliability": "node scripts/run-reliability.mjs",
    "test:perf": "node scripts/run-perf.mjs",
    "gate:clippy": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "gate:fmt": "cargo fmt --all --check",
    "gate:rust-test": "cargo test --workspace --locked",
    "gate:coverage": "cargo llvm-cov -p kp-domain --locked --fail-under-lines 85",
    "gate:lockfile": "pnpm install --frozen-lockfile --dry-run",
    "gate:naming": "node scripts/run-shell-gate.mjs check-naming",
    "gate:path-encapsulation": "node scripts/run-shell-gate.mjs check-path-encapsulation",
    "gate:rust-build": "cargo build --manifest-path src-tauri/Cargo.toml --locked",
    "build": "vite build",
    "build:verify": "pnpm build && node scripts/verify-build-integrity.mjs",
    "contract:verify": "node scripts/verify-ipc-contract.mjs",
    "tauri": "tauri",
    "ci": "node scripts/run-gates.mjs",
    "dev": "vite",
    "fixture:gen": "node scripts/gen-fixture-vault.mjs",
    "gate:rust": "pnpm gate:clippy && pnpm gate:fmt && pnpm gate:rust-test && pnpm gate:coverage && cargo audit --file Cargo.lock",
    "changelog:gen": "node scripts/changelog.mjs",
    "changelog:self-test": "node scripts/changelog.mjs --self-test",
    "release:prepare": "node scripts/prepare-release.mjs",
    "pr": "node --use-system-ca scripts/pr-flow.mjs"
  },
  "dependencies": {
    "@tanstack/vue-virtual": "^3.13.39",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "2.8.0",
    "dompurify": "^3.4.15",
    "markdown-it": "^15.0.2",
    "md-editor-v3": "^6.5.6",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^3.0.0",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.0",
    "vitest": "^3.0.0",
    "vue-eslint-parser": "^9.0.0",
    "vue-tsc": "^3.3.11"
  },
  "license": "MIT OR Apache-2.0"
}
